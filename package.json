{
  "name": "fame-game-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest",
    "test:run": "vitest run",
    "test:functional": "playwright test",
    "test:all": "vitest run && playwright test",
    "generate:items": "node scripts/generate-item-icons.mjs",
    "generate:items:ai": "node scripts/generate-item-icons-ai.mjs",
    "generate:items:all": "node scripts/generate-item-icons.mjs && node scripts/generate-item-icons-ai.mjs",
    "strip:item-backgrounds": "node scripts/restore-item-icons.mjs",
    "restore:item-icons": "node scripts/restore-item-icons.mjs",
    "import:krypta-enemies": "node scripts/import-dungeon-stage-enemies.mjs krypta",
    "generate:krypta-enemies": "node scripts/generate-krypta-stage-enemies.mjs",
    "generate:kraken-enemies": "node scripts/generate-kraken-stage-enemies.mjs",
    "import:kraken-enemies": "node scripts/import-dungeon-stage-enemies.mjs kraken",
    "generate:forteca-enemies": "node scripts/generate-forteca-stage-enemies.mjs",
    "import:forteca-enemies": "node scripts/import-dungeon-stage-enemies.mjs forteca",
    "generate:wulkan-enemies": "node scripts/generate-wulkan-stage-enemies.mjs",
    "import:wulkan-enemies": "node scripts/import-dungeon-stage-enemies.mjs wulkan",
    "generate:palac-enemies": "node scripts/generate-palac-stage-enemies.mjs",
    "import:palac-enemies": "node scripts/import-dungeon-stage-enemies.mjs palac"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@tanstack/react-query": "^5.74.4",
    "i18next": "^21.9.1",
    "i18next-browser-languagedetector": "^8.0.5",
    "lucide-react": "^0.510.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^11.18.6",
    "react-router-dom": "^7.5.2",
    "react-tooltip": "^5.28.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@playwright/test": "^1.51.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.19.15",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.23.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "msw": "^2.12.14",
    "sharp": "^0.34.5",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0",
    "vite": "^6.2.3",
    "vitest": "^3.1.1"
  }
}
